# Database Configuration
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/myblog_py

# Optional: create an initial user when running python init_db.py
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=

# Secret Key for Flask - Use a strong random key for production
SECRET_KEY=change-this-to-a-random-secret-key

# JWT Secret Key for API Authentication - Use a strong random key for production
JWT_SECRET_KEY=change-this-to-a-random-jwt-key

# Optional legacy token API secret (generate independently)
TOKEN_SECRET_KEY=change-this-to-a-random-token-key

# Debug Mode - Set to False for production
FLASK_DEBUG=True

# DuckDB Storage Configuration (Used in production; in-memory used in dev mode)
DUCKDB_PATH=data/ai_sessions.duckdb

# Pi Agent (available to every logged-in user)
PI_EXECUTABLE=pi
PI_WORKSPACE=data/pi-workspace
PI_DATA_DIR=data/pi
PI_SYSTEM_PROMPT_FILE=config/pi-system-prompt.txt
# Optional: leave empty to use the service account's Pi defaults
PI_PROVIDER=
PI_MODEL=
PI_TIMEOUT=600
# Internal nightly memory job (no cron required); hour is in the server timezone
PI_MEMORY_ENABLED=True
PI_MEMORY_HOUR=3
# Optional provider/model for summaries; defaults to Pi settings above
PI_MEMORY_MODEL=
# Total multipart request size (default 200 MiB, including upload metadata)
PI_MAX_UPLOAD_BYTES=209715200
# Optional: point at the service account's existing Pi configuration
# PI_CODING_AGENT_DIR=/home/appuser/.pi/agent
