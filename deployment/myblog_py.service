# Example: customize the user, paths, Node/Pi PATH, and host before installing.
[Unit]
Description=myblog_py Flask application
After=network.target

[Service]
User=appuser
Group=appuser
WorkingDirectory=/opt/myblog_py
EnvironmentFile=/opt/myblog_py/.env
Environment="HOME=/home/appuser"
Environment="PATH=/opt/myblog_py/.venv/bin:/home/appuser/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/myblog_py/.venv/bin/gunicorn --workers 1 --threads 8 --timeout 660 --bind 127.0.0.1:8000 app:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
